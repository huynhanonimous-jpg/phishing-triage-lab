#!/usr/bin/env python3
"""Safe, offline red/blue security learning menu.

This CLI performs local, read-only triage and defensive planning. It does not
probe networks, test live services, exploit systems, execute samples, or send data.
"""

import json
from pathlib import Path

from phishing_check import inspect_local_html, inspect_url
from scanner import scan, sha256_file

BANNER = r"""
       .--.  .--.
      |  |  |  |
   .--.______.--.
  /   .-.  .-.  \\
  |   |  |_|  |  |
   \\   `-._.-'  /
    `-._     _.-'
        `-.-'
      [ SAFE LAB ]
     RED / BLUE TOOL
"""

MENU = """
  1) Check a URL (offline text heuristics)
  2) Inspect a saved local HTML file (static only)
  3) Triage a local file (read-only)
  4) Calculate a file SHA-256
  5) Red-team exercise planner (scope/authorization checklist only)
  6) Blue-team incident-response tabletop
  7) Blue-team hardening checklist
  8) Export the latest result as JSON
  9) Internal web security review checklist (manual, authorized)
 10) Wi-Fi security hardening checklist (defensive)
 11) Vulnerability remediation worksheet
  0) Exit
"""

latest_report = None


def show_json(data):
    print(json.dumps(data, indent=2, ensure_ascii=False))


def run_url_check():
    global latest_report
    url = input("URL to inspect as text only: ").strip()
    latest_report = {"url_analysis": inspect_url(url)}
    show_json(latest_report)


def run_html_check():
    global latest_report
    path = input("Path to an existing local HTML file: ").strip().strip('"')
    context = input("URL represented by that file (context only; not visited): ").strip()
    url_report = inspect_url(context)
    html_report = inspect_local_html(path, url_report["normalized_url"])
    latest_report = {"url_analysis": url_report, "html_analysis": html_report}
    show_json(latest_report)


def run_file_triage():
    global latest_report
    path = Path(input("Path to a local file (will not be executed or changed): ").strip().strip('"'))
    latest_report = {"file_analysis": scan(path)}
    show_json(latest_report)


def run_hash_file():
    global latest_report
    path = Path(input("Path to a local file: ").strip().strip('"'))
    if not path.is_file():
        raise ValueError("Path is not a regular file.")
    latest_report = {"file": path.name, "sha256": sha256_file(path)}
    show_json(latest_report)


def run_red_team_planner():
    global latest_report
    print("\nPlanning only. Obtain written authorization before any assessment.")
    plan = {
        "exercise_type": "authorized assessment planning",
        "scope": input("Explicitly authorized assets (avoid secrets): ").strip(),
        "authorization_reference": input("Written authorization / owner: ").strip(),
        "objective": input("Learning objective: ").strip(),
        "approved_time_window": input("Approved time window: ").strip(),
        "stop_condition": input("Stop condition / emergency contact: ").strip(),
        "checklist": [
            "Confirm written permission, asset ownership, and an approved scope.",
            "List in-scope and explicitly out-of-scope systems.",
            "Agree on timing, communications, data handling, and stop procedure.",
            "Prefer tabletop exercises and vendor-approved, non-destructive validation.",
            "Do not collect real credentials, access third-party systems, or disrupt services.",
            "Share observations with the owner and track remediation to closure.",
        ],
        "execution": "None. This planner does not connect to, scan, or modify systems.",
    }
    latest_report = {"authorized_exercise_plan": plan}
    show_json(latest_report)


def run_blue_tabletop():
    global latest_report
    scenario = input("Tabletop scenario (e.g. suspected phishing email): ").strip()
    report = {
        "exercise": "blue-team incident-response tabletop",
        "scenario": scenario or "A user reports a suspicious message or login prompt.",
        "discussion_prompts": [
            "Who validates the report and decides the response path?",
            "How do you preserve evidence without opening risky content?",
            "Which systems or accounts need review by authorized staff?",
            "Who informs impacted users and leadership?",
            "What logs, timeline, and decisions should be documented?",
            "What recovery and follow-up improvements are needed?",
        ],
        "note": "Training scenario only; no messages, accounts, or systems are accessed.",
    }
    latest_report = {"blue_team_tabletop": report}
    show_json(latest_report)


def run_hardening_checklist():
    global latest_report
    report = {
        "blue_team_baseline": [
            "Enable automatic updates and supported endpoint protection.",
            "Use a password manager, unique passwords, and MFA.",
            "Keep versioned offline backups and test restoration.",
            "Use least privilege and avoid admin work on standard accounts.",
            "Teach users to report suspicious links and verify requests through another channel.",
            "Review sign-in alerts and suspicious activity with approved tools.",
            "Document response contacts, escalation paths, and recovery sequence.",
        ],
        "note": "General defensive guidance; adapt to your environment and policies.",
    }
    latest_report = {"blue_team_baseline": report}
    show_json(latest_report)


def run_internal_web_review():
    global latest_report
    system = input("Owned internal web app/service name (do not enter credentials): ").strip()
    report = {
        "review_type": "manual defensive web security review",
        "asset": system,
        "authorization_reminder": "Review only systems you own or have explicit written permission to assess.",
        "checklist": [
            "Confirm asset owner, approved scope, test window, and a rollback/contact plan.",
            "Check supported software versions and apply vendor security updates.",
            "Review TLS certificate validity and HTTPS-only configuration in approved admin tooling.",
            "Review security headers and cookie flags (Secure, HttpOnly, SameSite) from configuration or trusted logs.",
            "Verify authentication, MFA, account recovery, and least-privilege access policies.",
            "Review input validation and access-control design with code review and non-production tests.",
            "Check that secrets are not stored in source code, client-side assets, or logs.",
            "Review backups, logging, alerting, dependency inventory, and incident-response ownership.",
            "Record evidence safely, assign a remediation owner, and retest after fixes using approved procedures.",
        ],
        "limits": "This option does not connect to the service, crawl it, submit inputs, or run vulnerability tests.",
    }
    latest_report = {"internal_web_review": report}
    show_json(latest_report)


def run_wifi_hardening():
    global latest_report
    network = input("Wi-Fi network label for your notes (no password): ").strip()
    report = {
        "review_type": "defensive Wi-Fi configuration checklist",
        "network_label": network,
        "checklist": [
            "Use WPA3-Personal where supported, otherwise WPA2-AES; avoid WEP and legacy TKIP.",
            "Set a long, unique Wi-Fi passphrase and change default router administrator credentials.",
            "Update router firmware from the manufacturer and disable remote administration unless required.",
            "Disable WPS if it is not needed; use a guest network for visitors and untrusted devices.",
            "Use a separate network or VLAN for IoT devices where available.",
            "Review connected-device lists in the router's own admin interface and remove unknown devices after verification.",
            "Use the router vendor's supported security settings; avoid sharing passwords in reports.",
            "For enterprise Wi-Fi, have the network owner review 802.1X/RADIUS configuration and certificate validation.",
        ],
        "limits": "No wireless discovery, packet capture, deauthentication, password testing, or connection attempts are performed.",
    }
    latest_report = {"wifi_hardening": report}
    show_json(latest_report)


def run_remediation_worksheet():
    global latest_report
    report = {
        "finding_id": input("Finding/ticket ID: ").strip(),
        "asset_owner": input("Authorized asset owner/team: ").strip(),
        "summary": input("Brief issue summary (no secrets): ").strip(),
        "impact": input("Business impact: ").strip(),
        "remediation": input("Planned fix or mitigation: ").strip(),
        "responsible_owner": input("Person/team responsible for the fix: ").strip(),
        "target_date": input("Target date: ").strip(),
        "validation_plan": input("Safe validation plan after the fix: ").strip(),
        "status": "Open - track through the organization's approved process",
        "note": "Do not include credentials, personal data, or sensitive exploit details in this report.",
    }
    latest_report = {"remediation_worksheet": report}
    show_json(latest_report)


def export_report():
    if latest_report is None:
        print("No result yet. Run one of the tools first.")
        return
    destination = Path(input("Output JSON path (e.g. reports/latest.json): ").strip().strip('"'))
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(json.dumps(latest_report, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
    print(f"Saved report to {destination}")


def main():
    actions = {
        "1": run_url_check,
        "2": run_html_check,
        "3": run_file_triage,
        "4": run_hash_file,
        "5": run_red_team_planner,
        "6": run_blue_tabletop,
        "7": run_hardening_checklist,
        "8": export_report,
        "9": run_internal_web_review,
        "10": run_wifi_hardening,
        "11": run_remediation_worksheet,
    }

    print(BANNER)
    print("Offline defensive triage + safe exercise planning. No live probing or payloads.")

    while True:
        print(MENU)
        choice = input("Choose an option: ").strip()
        if choice == "0":
            print("Bye! Stay within authorized lab scope.")
            return

        action = actions.get(choice)
        if action is None:
            print("Unknown option; choose 0-11.")
            continue

        try:
            action()
        except (OSError, ValueError) as error:
            print(f"Could not complete that action: {error}")

        input("\nPress Enter to continue...")


if __name__ == "__main__":
    main()
